# Copy to .env at the repo root. Both apps load it. Never commit .env.

# --- engine only ---
HELIUS_API_KEY=your-helius-api-key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your-helius-api-key
DATABASE_URL=postgres://soltracer:soltracer@127.0.0.1:5432/soltracer
# Comma-separated base58 wallet addresses allowed to sign in.
ALLOWLIST=
ENGINE_PORT=4000

# --- web only ---
# At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=
ENGINE_URL=http://127.0.0.1:4000

# --- shared between web and engine ---
# At least 32 characters. Generate with: openssl rand -base64 32
ENGINE_TOKEN=
