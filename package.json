{
  "name": "soltracer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n engine,web -c magenta,cyan \"pnpm --filter @soltracer/engine dev\" \"pnpm --filter @soltracer/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @soltracer/web e2e",
    "db:generate": "pnpm --filter @soltracer/engine db:generate",
    "db:migrate": "pnpm --filter @soltracer/engine db:migrate",
    "db:rollback": "pnpm --filter @soltracer/engine db:rollback",
    "check:bundle": "node scripts/check-bundle-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
